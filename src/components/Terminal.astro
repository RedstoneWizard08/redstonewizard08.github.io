---
import TermWindow from "./TermWindow.svelte";
---

<div class="flex h-full w-full flex-col p-4">
    <div class="text-lg font-bold mb-2">
        <a href="/" class="border-b-0 hover:border-b-2">
            <span class="text-green-300 text-lg">&gt;</span>
            Redstone's Website
            <span class="text-green-300 text-lg animate-blink">_</span>
        </a>
    </div>

    <TermWindow client:only />
</div>

<style>
    @keyframes blink {
        from {
            opacity: 1;
        }

        to {
            opacity: 0;
        }
    }

    .animate-blink {
        animation: blink 1s steps(2, jump-none) infinite;
    }
</style>
