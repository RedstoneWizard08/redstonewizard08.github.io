---
import TermWindow from "./TermWindow.svelte";
---

<div class="flex h-full w-full flex-col p-4">
    <div class="mb-2 text-lg font-bold">
        <a href="/" class="border-b-0 hover:border-b-2">
            <span class="text-lg text-green-300">&gt;</span>
            Redstone's Website
            <span class="text-lg text-blue-300" id="loading">[Loading...]</span>
            <span class="animate-blink text-lg text-green-300">_</span>
        </a>
    </div>

    <TermWindow client:only />

    <script>
        const loader = document.getElementById("loading");

        declare global {
            interface Window {
                onLoadFinish?: () => void;
            }
        }

        window.onLoadFinish = () => {
            if (loader) loader.style.display = "none";
        };
    </script>
</div>

<style>
    @keyframes blink {
        from {
            opacity: 1;
        }

        to {
            opacity: 0;
        }
    }

    .animate-blink {
        animation: blink 1s steps(2, jump-none) infinite;
    }
</style>
