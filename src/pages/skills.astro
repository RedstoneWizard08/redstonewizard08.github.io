---
import Chip from "@/components/Chip.astro";
import Layout from "@/components/Layout.astro";
import { skills } from "@/projects";
import { Icon } from "astro-icon/components";
---

<Layout title="Skills">
    <div class="m-8 flex w-full flex-col items-start justify-start space-y-4">
        <p class="text-purple text-2xl">My Skills</p>
        <p class="font-300 text-op-70 mb-8 text-white">
            These are technologies, frameworks, and systems I know how to use
            and feel proficient with.
        </p>

        <div class="mt-8 block w-full space-y-6 space-x-6 text-center">
            {
                Object.keys(skills)
                    .toSorted()
                    .map((id) => (
                        <div class="inline-flex w-fit flex-row items-center justify-start bg-slate-800 p-4 transition-all hover:bg-slate-700">
                            <Icon
                                size="24px"
                                class="mr-2"
                                name={skills[id].icon.replace(
                                    /^iconify:/gm,
                                    ""
                                )}
                            />

                            <p class="text-emerald text-xl font-bold">
                                {skills[id].name}
                            </p>
                        </div>
                    ))
            }
        </div>
    </div>
</Layout>
