---
import Layout from "@/components/Layout.astro";
---

<Layout>
    <div
        class="mt-16 flex h-full w-full flex-col items-center justify-center p-8"
    >
        <p class="text-red mb-12 text-3xl">
            Oops! That page couldn't be found! :/
        </p>

        <p class="mb-12 text-lg md:w-180">
            You can still navigate around. Be more careful 'round these parts,
            eh? You don't wanna know what goes on in these errors...
        </p>

        <a
            href="/"
            class="bg-op-30 bg-red-700 p-4 px-6 text-xl font-bold transition-all hover:bg-red-500"
            >Go Home</a
        >
    </div>
</Layout>
